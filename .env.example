# Copy this file to .env. No API keys are needed: every call goes to
# hailo-ollama on a Hailo-10H (Raspberry Pi AI HAT+ 2), HailoRT 5.4.0+.
#
# Start the server (port 8000 by default; hailo-ollama reads OLLAMA_HOST):
#   hailo-ollama
#   curl http://localhost:8000/hailo/v1/list          # models your build supports
#   curl http://localhost:8000/api/pull -H 'Content-Type: application/json' \
#        -d '{"model": "qwen3:1.7b", "stream": true}'

# Where the agent finds hailo-ollama (falls back to OLLAMA_HOST, then this default)
HAILO_OLLAMA_HOST=http://localhost:8000

# native = Ollama `tools` field on /api/chat (default; works on 5.4.0 with qwen3:1.7b)
# prompt = tools described in the system prompt (older servers, or models
#          without tool support such as gemma4:e2b). The agent also switches
#          to prompt automatically when the server answers "does not support tools".
HAILO_TOOL_MODE=native
